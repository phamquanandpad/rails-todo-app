{
  data: @users.map { |u|
    {
      id:               u.id,
      username:         u.username,
      email:            u.email,
      role:             u.role,
      permissionsCount: u.user_permissions.size,
      createdAt:        u.created_at,
      updatedAt:        u.updated_at
    }
  },
  meta: {
    page:       @pagy.page,
    limit:      @pagy.limit,
    totalPages: @pagy.pages,
    totalCount: @pagy.count
  }
}
